{
  "name": "gestock",
  "version": "1.4.0",
  "description": "Gestão de stocks do Posto Médico e Armazém de Saúde",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dev": "electron .",
    "configure-updates": "node scripts/configure-updates.cjs",
    "check": "node scripts/check-source.cjs",
    "test": "node tests-updates.cjs && node tests-moderation.cjs && node tests-accounts.cjs && node tests-accounts-server.cjs && node tests-gestock.cjs && node tests-sync.cjs && node tests-v110.cjs && node tests-lookup-reports.cjs && node tests-v120.cjs && node tests-v120-integration.cjs && node tests-v130.cjs && node tests-v140.cjs",
    "verify-release": "node scripts/verify-release.cjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pt.gestock.app",
    "productName": "Gestock",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "README.md",
      "supabase/*.sql",
      "branding.js",
      "STATUS-v23.md",
      "design.css",
      "access.js",
      "updates.js",
      "update-config.json",
      "STATUS-v24.md",
      "STATUS-v241.md",
      "app-config.js",
      "stock.js",
      "stock.css",
      "identity.css",
      "assets/*.ico",
      "assets/identity/gestock-logo-refined-dark.png",
      "assets/identity/gestock-background-approved.png",
      "portal.js",
      "portal.css",
      "reports.js",
      "supabase/migrations/*.sql",
      "VALIDATION-v110.md",
      "password-gate.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/gestock-icon-v1.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/gestock-icon-v1.ico",
      "uninstallerIcon": "assets/gestock-icon-v1.ico",
      "shortcutName": "Gestock",
      "uninstallDisplayName": "Gestock",
      "include": "build/windows-shortcuts.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Storm1408",
        "repo": "GESTOCK",
        "releaseType": "release"
      }
    ],
    "artifactName": "Gestock.${ext}",
    "extraResources": [
      {
        "from": "assets/gestock-icon-v1.ico",
        "to": "gestock-shell-icon-v2.ico"
      }
    ]
  },
  "author": "GESTOCK",
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
